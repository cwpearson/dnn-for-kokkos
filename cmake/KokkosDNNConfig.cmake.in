@PACKAGE_INIT@

# find_dependency() loads the dependency's package config into this scope.
# With CMake <= 3.29 (Ubuntu 24.04 ships 3.28) a dependency can overwrite
# PACKAGE_PREFIX_DIR: Kokkos' config sets it to <kokkos-prefix>/lib, so a
# later "${PACKAGE_PREFIX_DIR}/include" resolves to <kokkos-prefix>/lib/include.
# Keep our own copy for paths that must stay inside this package's tree, and
# restore it afterwards (CMake >= 3.30 preserves it across find_dependency).
set(_KokkosDNN_PACKAGE_PREFIX_DIR "${PACKAGE_PREFIX_DIR}")

include(CMakeFindDependencyMacro)

# Core dependency: Kokkos >= 5.2.1 (see CMakeLists.txt find_package(Kokkos)).
find_dependency(Kokkos 5.2.1)

# TPLs linked PUBLICly by KokkosDNN::kokkosdnn must resolve in the
# consumer. Each guard is baked in at build time: only TPLs enabled when
# this package was configured trigger a find_dependency in the consumer.
if(@KokkosDNN_ENABLE_CUBLAS@ OR @KokkosDNN_ENABLE_CUDNN@)
  find_dependency(CUDAToolkit)
endif()

if(@KokkosDNN_USE_CUDNN_CONFIG@)
  # Build linked CUDNN::cudnn from a CUDNN package config; re-find it here.
  # (When the build fell back to manual CUDNN_LIBRARY paths, absolute paths
  # are baked into the targets file and no find is needed.)
  find_dependency(CUDNN)
endif()

if(@KokkosDNN_ENABLE_HIPBLAS@)
  find_dependency(hipblas)
endif()

if(@KokkosDNN_USE_MIOPEN_CONFIG@)
  # Same split as CUDNN above: config target vs. manual absolute paths.
  find_dependency(miopen)
endif()

# NOTE: KokkosDNN_ENABLE_ACCELERATE needs no find: Accelerate is an Apple
# system framework linked by absolute path baked into the targets file.

if(@KOKKOSDNN_ENABLE_CUDNN@ AND NOT TARGET cudnn_frontend)
  # Header-only cuDNN graph API: FetchContent at build time, deliberately
  # not in our export set. Define the link name the exported
  # KokkosDNN::kokkosdnn target refers to, backed by the headers staged in
  # <prefix>/include by the build (see CMakeLists.txt). A consumer that
  # already provides cudnn_frontend keeps its own.
  add_library(cudnn_frontend INTERFACE IMPORTED)
  set_target_properties(cudnn_frontend PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_KokkosDNN_PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
    INTERFACE_COMPILE_FEATURES cxx_std_17)
endif()

# Undo any PACKAGE_PREFIX_DIR clobbering by the dependency configs above.
set(PACKAGE_PREFIX_DIR "${_KokkosDNN_PACKAGE_PREFIX_DIR}")
unset(_KokkosDNN_PACKAGE_PREFIX_DIR)

include("${CMAKE_CURRENT_LIST_DIR}/KokkosDNNTargets.cmake")
check_required_components(KokkosDNN)
